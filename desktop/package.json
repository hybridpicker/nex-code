{
  "name": "nex-code-desktop",
  "version": "0.0.1",
  "description": "nex-code Desktop — Cyber-Obsidian coding assistant with TUI and Electron modes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "tui": "ts-node src/tui/index.ts",
    "tui:build": "tsc && node dist/tui/index.js",
    "build": "tsc",
    "build:electron": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --linux --win",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.nexcode.desktop",
    "productName": "nex-code",
    "directories": {
      "output": "../dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "nex-code-cli"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "renderer/assets/icon.icns",
      "darkModeSupport": true
    },
    "linux": {
      "category": "Development",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] }
      ],
      "icon": "renderer/assets/icon.png"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/jest": "^30.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
